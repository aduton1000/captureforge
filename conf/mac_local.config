// ── conf/mac_local.config ──────────────────────────────────────────────────
// Full single-machine run on the authoring Mac. Heavy steps (whole-genome
// indexing + specificity mapping) run here but are slow on a laptop — the
// multi-gene production run is intended for the HPC (see hpc_slurm).
//   nextflow run main.nf -profile mac_local,conda -params-file params.yaml
params {
    config_profile_name        = 'Mac local (full)'
    config_profile_description  = 'Full pipeline on a single macOS machine'

    max_cpus   = 8
    max_memory = '24.GB'
    max_time   = '48.h'
}

process {
    executor = 'local'
}

// Apple Silicon: prefer native osx-arm64 conda builds; tools without them are
// pulled as x86_64 containers (Rosetta) and flagged in the report.
conda.useMamba = true
