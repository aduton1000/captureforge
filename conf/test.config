// ── conf/test.config ───────────────────────────────────────────────────────
// Tiny end-to-end run: 10 genes spanning every design class, on a
// chromosome-subset reference, completes on a Mac in minutes.
//   nextflow run main.nf -profile test,conda
params {
    config_profile_name        = 'Test profile'
    config_profile_description  = '10-gene end-to-end sanity run on a subset reference'

    // Modest ceilings so it runs on a laptop
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '2.h'

    panel_name = 'captureforge_test10'

    // 10 genes chosen to exercise coding / promoter / regulatory / cnv / str / anchor.
    // (Provided as a CSV spec shipped in test/data; see test/data/test_genes.csv)
    input        = "${projectDir}/test/data/test_genes.csv"

    // Mini-genome built by test/data/make_test_reference.sh from the local
    // GRCh38 primary FASTA — each test gene's locus ± flank as its own contig.
    genome_fasta    = "${projectDir}/test/data/ref/test_genome.fa"
    gtf             = "${projectDir}/test/data/ref/test_genes.gtf"
    specificity_db  = "${projectDir}/test/data/ref/test_noalt"   // BLAST db over the mini-genome
    specificity_aligner = 'blast'
    rsid_bed        = "${projectDir}/test/data/ref/test_anchors.rsid.bed"
    regulatory_gff  = "${projectDir}/test/data/ref/test_regulatory.gff"  // tiny track → regulatory class

    // Lighter re-tiling keeps the test fast.
    retile_max_passes = 2
}
