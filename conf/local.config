// ── conf/local.config ──────────────────────────────────────────────────────
// Run the full pipeline on a SINGLE machine (the `local` execution profile) — any
// Linux or macOS host (Windows via WSL2), laptop or workstation. Not Mac-specific;
// heavy steps (whole-genome indexing + specificity mapping) are slow on a laptop —
// the multi-gene production run is intended for the HPC (see hpc_slurm). `mac_local`
// remains a deprecated alias for this profile.
//   captureforge run -profile local,conda -params-file params.yaml
params {
    config_profile_name        = 'Local (single machine)'
    config_profile_description  = 'Full pipeline on one Linux/macOS machine'

    max_cpus   = 8
    max_memory = '24.GB'
    max_time   = '48.h'
}

process {
    executor = 'local'
}

// Apple Silicon: prefer native osx-arm64 conda builds; tools without them are
// pulled as x86_64 containers (Rosetta) and flagged in the report.
conda.useMamba = true
