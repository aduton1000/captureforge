// ── conf/base.config ───────────────────────────────────────────────────────
// Always-applied defaults: resource labels, retries, error strategy, publishing.

process {

    // Image every task runs inside (empty = native/host). Read by the docker/
    // singularity/apptainer executors, which run e.g. `singularity exec <container> …`.
    // Set via --container_image / params file. Applies to ALL processes (incl. the
    // viz stages) since no module overrides `container`.
    container = params.container_image

    cpus   = 1
    memory = { 2.GB * task.attempt }
    time   = { 1.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: small  { cpus = 1;            memory = { 2.GB  * task.attempt }; time = { 1.h  * task.attempt } }
    withLabel: medium { cpus = 2;            memory = { 6.GB  * task.attempt }; time = { 4.h  * task.attempt } }
    withLabel: large  { cpus = { 4 * task.attempt }; memory = { 12.GB * task.attempt }; time = { 12.h * task.attempt } }

    // Whole-genome indexing / specificity mapping is the heavy step.
    withLabel: index  { cpus = { 4 * task.attempt }; memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
}

// Trace directory for pipeline_info outputs
params.tracedir = "${params.outdir}/pipeline_info"

// NOTE: resource ceilings are applied as explicit per-label values in each
// profile (see max_cpus/max_memory/max_time params and the withLabel blocks),
// rather than an nf-core-style check_max() helper — the Nextflow strict config
// parser disallows function/import declarations in config files.
