// ── conf/hpc_slurm.config ──────────────────────────────────────────────────
// SLURM cluster execution with Apptainer/Singularity (Docker usually forbidden).
//   nextflow run main.nf -profile hpc_slurm,apptainer -params-file params.yaml
params {
    config_profile_name        = 'HPC SLURM'
    config_profile_description  = 'SLURM executor + Apptainer on a shared cluster'

    // Cluster-specific knobs (override on the command line / params file)
    slurm_partition = 'normal'
    slurm_queue_opts= ''
    scratch_dir     = '/tmp'

    max_cpus   = 32
    max_memory = '128.GB'
    max_time   = '72.h'
}

process {
    executor   = 'slurm'
    queue      = { params.slurm_partition }
    clusterOptions = { params.slurm_queue_opts }
    scratch    = { params.scratch_dir }

    // Heavy genome index/specificity steps get a big slot.
    withLabel: index { cpus = 16; memory = 64.GB; time = 24.h }
    withLabel: large { cpus = 8;  memory = 32.GB; time = 12.h }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1min'
}

// Centralized container cache shared across cluster users.
// Override via --apptainer_cache or env CAPTUREFORGE_APPTAINER_CACHE in your launch script.
params.apptainer_cache = "$HOME/.apptainer/captureforge"
apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = params.apptainer_cache
}
