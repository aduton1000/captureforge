// ── conf/hpc_slurm.config ──────────────────────────────────────────────────
// SLURM cluster execution with Apptainer or SingularityCE (Docker usually forbidden).
//   nextflow run main.nf -profile hpc_slurm,apptainer   -params-file params.yaml
//   nextflow run main.nf -profile hpc_slurm,singularity -params-file params.yaml
params {
    config_profile_name        = 'HPC SLURM'
    config_profile_description  = 'SLURM executor + Apptainer/Singularity on a shared cluster'

    // Cluster-specific knobs (override on the command line / params file)
    slurm_partition = 'normal'
    slurm_queue_opts= ''
    scratch_dir     = '/tmp'

    max_cpus   = 32
    max_memory = '128.GB'
    max_time   = '72.h'
}

process {
    executor   = 'slurm'
    queue      = { params.slurm_partition }
    clusterOptions = { params.slurm_queue_opts }
    scratch    = { params.scratch_dir }

    // Heavy genome index/specificity steps get a big slot.
    withLabel: index { cpus = 16; memory = 64.GB; time = 24.h }
    withLabel: large { cpus = 8;  memory = 32.GB; time = 12.h }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1min'
}

// Centralized container-image cache shared across cluster users.
// The container ENGINE is chosen by the packaging profile you compose with
// hpc_slurm — do NOT enable an engine here, or composing the other one would
// leave two engines enabled (Nextflow rejects that). Both run the same .sif:
//   -profile hpc_slurm,apptainer     (Apptainer sites)
//   -profile hpc_slurm,singularity   (SingularityCE sites — no `apptainer` binary)
// Override the cache via --container_cache, or set CAPTUREFORGE_APPTAINER_CACHE /
// CAPTUREFORGE_SINGULARITY_CACHE in your launch script.
params.container_cache = "${env('HOME')}/.captureforge/container_cache"
params.apptainer_cache = params.container_cache   // back-compat alias
// cacheDir is applied to whichever engine the packaging profile enables; setting
// it on the disabled engine is harmless. autoMounts comes from the packaging profile.
apptainer.cacheDir   = params.container_cache
singularity.cacheDir = params.container_cache
