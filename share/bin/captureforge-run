#!/usr/bin/env bash
# Shared launcher for CaptureForge on an HPC cluster.
#
# Works WITH or WITHOUT a module system:
#   • Lmod sites:   `module load captureforge` sets CAPTUREFORGE_HOME/_SIF/_REFS, then run this.
#   • No-module sites: drop this script on a shared PATH (e.g. put
#     <install_root>/share/bin on PATH). It resolves everything from environment
#     variables + install-relative defaults — no `module load` required.
#
# Usage (with the site env sourced — see share/captureforge-env.sh.example):
#   captureforge-run -params-file site.params.yaml --input panel.txt --outdir results
#   captureforge-run --help
# slurm_partition, container_image, bind_paths, specificity_db, genome_fasta, gtf
# all belong in the params file; put queue there (slurm_partition: <queue>) so it is
# NOT a required flag. Override per-run with --slurm_partition <queue> if needed.
#
# Environment (all optional; defaults derived from this script's install location):
#   CAPTUREFORGE_HOME     install/repo root        (default: parent of this script's share/bin)
#   CAPTUREFORGE_SIF      path to captureforge.sif (default: $CAPTUREFORGE_HOME/captureforge.sif)
#   CAPTUREFORGE_REFS     reference dir            (default: $CAPTUREFORGE_HOME/refs)
#   CAPTUREFORGE_ENGINE   apptainer | singularity  (default: singularity — this cluster has no `apptainer`)
#   CAPTUREFORGE_PROFILE  full -profile string     (default: hpc_slurm,$CAPTUREFORGE_ENGINE)
# Forwards all extra args straight through to `nextflow run`.
set -euo pipefail

# --- resolve install root WITHOUT Lmod -------------------------------------
# This script lives at <CAPTUREFORGE_HOME>/share/bin/captureforge-run; derive the
# root from its own location so it works when simply placed on PATH.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_default_home="$(cd "${_self_dir}/../.." && pwd)"
CAPTUREFORGE_HOME="${CAPTUREFORGE_HOME:-$_default_home}"

# --- container engine + profile (selectable; default singularity) ----------
# Default to SingularityCE (this cluster has no `apptainer` binary); an Apptainer
# site sets CAPTUREFORGE_ENGINE=apptainer (or CAPTUREFORGE_PROFILE=hpc_slurm,apptainer).
ENGINE="${CAPTUREFORGE_ENGINE:-singularity}"
case "$ENGINE" in
  apptainer|singularity) ;;
  *) echo "[captureforge-run] ERROR: CAPTUREFORGE_ENGINE must be 'apptainer' or 'singularity' (got '$ENGINE')" >&2; exit 2 ;;
esac
PROFILE="${CAPTUREFORGE_PROFILE:-hpc_slurm,${ENGINE}}"

# --- image + refs with install-relative defaults ---------------------------
SIF="${CAPTUREFORGE_SIF:-${CAPTUREFORGE_HOME}/captureforge.sif}"
REFS="${CAPTUREFORGE_REFS:-${CAPTUREFORGE_HOME}/refs}"

# Host paths to bind into task containers (engine-neutral). Needed when refs are
# referenced in place outside $HOME/CWD (e.g. /hpc). Empty = no bind.
BIND="${CAPTUREFORGE_BIND:-}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
captureforge-run — shared HPC launcher (forwards to: nextflow run main.nf)
  CAPTUREFORGE_HOME    = ${CAPTUREFORGE_HOME}
  CAPTUREFORGE_ENGINE  = ${ENGINE}
  CAPTUREFORGE_PROFILE = ${PROFILE}
  CAPTUREFORGE_SIF     = ${SIF}
  CAPTUREFORGE_REFS    = ${REFS}
  CAPTUREFORGE_BIND    = ${BIND:-<none>}   # container bind mounts (exports SINGULARITY_BIND/APPTAINER_BIND + --bind_paths)

usage: captureforge-run -params-file site.params.yaml --input panel.txt --outdir results [nextflow args]
Put slurm_partition/container_image/bind_paths/refs in the params file; override with flags if needed.
No module system required: source share/captureforge-env.sh (or put <install_root>/share/bin on PATH).
EOF
  exit 0
fi

# Wire the image to process.container (via --container_image) so every task runs
# inside it. The engine itself is turned on by the composed profile; both engines
# run the same .sif. (An empty/missing image + enabled engine fails loudly in main.nf.)
extra=()
if [[ -f "$SIF" ]]; then
  extra+=("--container_image" "$SIF")
else
  echo "[captureforge-run] note: no .sif at '$SIF' — set CAPTUREFORGE_SIF to point at captureforge.sif, or pass --container_image. Without an image the run will fail loudly (engine enabled, no image)." >&2
fi
if [[ -d "$REFS" ]]; then
  [[ -e "$REFS/grch38_noalt_bt2.1.bt2" || -e "$REFS/grch38_noalt.nsq" ]] || \
    echo "[captureforge-run] note: build a no-alt specificity index in $REFS (see docs/hpc_deployment.md)" >&2
fi
# Make referenced-in-place refs visible inside tasks, via BOTH supported routes:
#   1) export SINGULARITY_BIND / APPTAINER_BIND — the engine reads these; Nextflow
#      whitelists them (engine profiles) so they survive its per-task env scrub. This
#      is the robust route (the engine-native var is honored host-side).
#   2) --bind_paths — applied via process.containerOptions (a per-task closure that
#      sees the merged value). Kept for resilience across Nextflow versions.
# Duplicate binds of the same path are idempotent.
if [[ -n "$BIND" ]]; then
  export SINGULARITY_BIND="${SINGULARITY_BIND:+$SINGULARITY_BIND,}$BIND"
  export APPTAINER_BIND="${APPTAINER_BIND:+$APPTAINER_BIND,}$BIND"
  extra+=("--bind_paths" "$BIND")
fi

# Prefer the vendored, version-pinned launcher (matches the `captureforge` CLI);
# fall back to a system `nextflow` on PATH.
NF="nextflow"
if [[ -x "${CAPTUREFORGE_HOME}/.tools/nextflow" ]]; then
  NF="${CAPTUREFORGE_HOME}/.tools/nextflow"
fi

# --- run state goes to a USER-WRITABLE dir, NEVER the read-only shared install ----
# Nextflow anchors its run state to launchDir == the process working directory:
# .nextflow/ (history, history.lock, cache) and the .nextflow.log live there, and
# -work-dir relocates ONLY work/ — not those. So we must launch from a writable
# place. We do NOT `cd` into the install (main.nf is referenced by absolute path),
# and we point the log + work dir + the launcher's own scratch (NXF_HOME/capsule)
# at user space too (belt-and-suspenders, in case launchDir alone isn't honored).
RUNDIR="${CAPTUREFORGE_RUNDIR:-$PWD}"
if ! ( : > "${RUNDIR}/.captureforge-wtest.$$" ) 2>/dev/null; then
  echo "[captureforge-run] ERROR: run directory is not writable: ${RUNDIR}" >&2
  echo "  CaptureForge writes run state (.nextflow/, logs, work/) to this directory." >&2
  echo "  Run from a writable directory (your home or a project dir), e.g.:" >&2
  echo "    cd ~ && captureforge-run -params-file site.params.yaml --input panel.txt --outdir results" >&2
  echo "  (or set CAPTUREFORGE_RUNDIR=/path/to/writable to override)." >&2
  exit 1
fi
rm -f "${RUNDIR}/.captureforge-wtest.$$"

# The launcher itself (capsule cache, framework, tmp) must be writable for a
# read-only install — never let it try to write next to itself in the repo.
export NXF_HOME="${NXF_HOME:-$HOME/.nextflow}"

# Pin the log (core option, BEFORE `run`) and work dir (run option) into the run
# dir unless the caller already set them (or NXF_WORK is exported).
pre=(); post=()
_have_log=0; _have_work=0
for _a in "$@"; do
  case "$_a" in
    -log|-log=*)            _have_log=1 ;;
    -work-dir|-w|-work-dir=*) _have_work=1 ;;
  esac
done
[[ $_have_log -eq 0 ]] && pre+=("-log" "${RUNDIR}/.nextflow.log")
[[ $_have_work -eq 0 && -z "${NXF_WORK:-}" ]] && post+=("-work-dir" "${RUNDIR}/work")

echo "[captureforge-run] ${NF} ${pre[*]:-} run ${CAPTUREFORGE_HOME}/main.nf -profile ${PROFILE} ${post[*]:-} ${extra[*]:-} $*" >&2
exec "$NF" ${pre[@]+"${pre[@]}"} run "${CAPTUREFORGE_HOME}/main.nf" \
    -profile "${PROFILE}" \
    ${post[@]+"${post[@]}"} ${extra[@]+"${extra[@]}"} "$@"
