# ═══════════════════════════════════════════════════════════════════════════
#  CaptureForge — Apptainer/Singularity definition (HPC; Docker usually banned)
#  Build:  apptainer build captureforge.sif env/captureforge.def
#  Native linux-64 toolchain (no emulation) for whole-genome production runs.
# ═══════════════════════════════════════════════════════════════════════════
Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    env/captureforge.yml /opt/captureforge.yml

%post
    micromamba install -y -n base -f /opt/captureforge.yml
    micromamba clean --all --yes
    echo 'export PATH=/opt/conda/bin:$PATH' >> $SINGULARITY_ENVIRONMENT

%environment
    # Tools install into BASE conda (/opt/conda) via `micromamba install -n base`
    # in %post — put its bin FIRST so `singularity exec <img> samtools` resolves by
    # bare name and does not depend on the host PATH leaking in.
    export PATH=/opt/conda/bin:$PATH
    # UTF-8 locale silences locale warnings from the bioinformatics CLIs.
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Container FS is read-only at run time; give matplotlib a writable cache dir
    # (otherwise it warns about a read-only /root/.config).
    export MPLCONFIGDIR=/tmp/matplotlib

%test
    bedtools --version
    samtools --version | head -1
    bowtie2 --version | head -1
    genmap --version
    dustmasker -version
    python -c "import pysam, Bio, pyfaidx, primer3, pandas, openpyxl, jinja2, matplotlib; print('py libs OK')"

%labels
    Name CaptureForge
    Version 0.1.0
    License MIT

%help
    CaptureForge hybridization-capture probe design pipeline.
    Run via Nextflow: nextflow run main.nf -profile hpc_slurm,singularity -params-file params.yaml
                      (or -profile hpc_slurm,apptainer on an Apptainer site — same .sif)
