# ── CaptureForge .gitignore ───────────────────────────────────────────────
# Never commit large reference data, indices, or runtime outputs.

# Per-user working config (contains real machine-specific paths); params.example.yaml
# is the public template. Never track the filled-in copy.
params.full.yaml
params.yaml

# Reference data & indices
refs/
# Top-level run/reference data only — anchored to repo root so the shipped
# `test/data/` fixture (re-included below) is NOT swept up by a bare `data/`.
/data/
indices/
*.fa
*.fasta
*.fa.gz
*.fasta.gz
*.fna
*.fai
*.gzi
*.dict
*.2bit
# aligner / blast indices
*.bt2
*.bt2l
*.bwt
*.bwt.2bit.64
*.amb
*.ann
*.pac
*.sa
*.0123
*.ndb
*.nhr
*.nin
*.njs
*.not
*.nsq
*.ntf
*.nto
# GenMap / mappability
*.genmap.*
# annotations are fetched, not committed
*.gtf
*.gtf.gz
*.gff
*.gff3
*.gff3.gz
# variant resources
dbsnp*.vcf*
*.vcf.gz.tbi

# Nextflow runtime
work/
.nextflow/
.nextflow.log*
results/
report-*.html
timeline-*.html
trace-*.txt
dag-*.html

# Provenance/checksums for fetched refs (machine-specific paths)
refs.provenance.json

# Python / conda
__pycache__/
*.pyc
.venv/
env/.conda/

# OS / editor
.DS_Store
**/.DS_Store
*.swp
.idea/
.vscode/

# Never commit curated gene-list workbooks (may contain unpublished panel data).
assets/gene_lists/*.xlsx

# Keep the small example/test inputs and templates (text/CSV only)
!assets/gene_lists/*.csv
!assets/gene_lists/*.tsv
!assets/gene_lists/*.txt
# Ship the pre-built generic test fixture (CSV spec + mini-genome + indices) so
# `captureforge run -profile test` works straight from a clone. This re-include
# overrides the broad *.fa/*.gtf/*.ndb/etc rules above for test/data/ only.
!test/data/**
# …but never ship OS junk that the blanket re-include would otherwise catch.
test/data/**/.DS_Store

# Local-only preserved data (e.g. a curated source workbook copy) — never committed
_local/

# local tool installs — ignore Nextflow's runtime cruft (downloaded distributions,
# caches, framework jars) but TRACK the small vendored Seqera launcher script so a
# fresh clone has the `.tools/nextflow` the CLI prefers.
.tools/*
!.tools/nextflow
.nextflow/

# transient conda build logs
env/*.log
env/.create_env.log
env/condaenv.*

# alternate nextflow work dirs
work*/
.nextflow*
