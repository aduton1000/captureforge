// ═══════════════════════════════════════════════════════════════════════════
//  CaptureForge — hybridization-capture probe (bait) design pipeline
//  nextflow.config : global params + profiles (test, mac_local, hpc_slurm)
//  Disease- and organism-agnostic: change inputs/config only, no code edits.
// ═══════════════════════════════════════════════════════════════════════════

manifest {
    name            = 'CaptureForge'
    author          = 'Genomics & Bioinformatics Core'
    description     = 'General-purpose hybridization-capture probe (bait) design pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

// ── Default parameters ─────────────────────────────────────────────────────
// Everything is overridable via -params-file params.yaml or --key value.
params {

    help               = false

    // ---- Input (one of: plain-text symbols / CSV-TSV spec / Excel workbook) ----
    input              = null                       // path to gene list (auto-detected)
    excel_sheet        = 'Candidate Panel (expanded)'   // sheet name if Excel
    panel_name         = 'captureforge_panel'

    // ---- Reference data (GRCh38 defaults; override for any build/organism) ----
    genome_build       = 'GRCh38'
    genome_fasta       = null                       // primary/no-alt FASTA (required)
    gtf                = null                       // Ensembl GTF (gene models)
    mane_gff           = null                       // optional: MANE Select GFF3 (canonical)
    regulatory_gff     = null                       // optional: Ensembl Regulatory Build / cCREs
    rmsk_bed           = null                       // optional: UCSC RepeatMasker
    segdups_bed        = null                       // optional: UCSC genomicSuperDups
    dbsnp_vcf          = null                       // optional: dbSNP VCF for rsID anchors
    ensembl_release    = 112

    // ---- Stage 1 : target definition ----
    canonical_source   = 'mane'                     // mane | ensembl_canonical | longest
    splice_flank       = 15                         // bp added around each exon
    promoter_upstream  = 2000                       // TSS-2000 ..
    promoter_downstream= 200                        // .. TSS+200
    anchor_flank       = 150                        // bp each side of an rsID anchor
    default_classes    = ['coding','promoter']      // applied to a bare symbol list

    // ---- Bait geometry ----
    bait_len           = 120                        // nt
    // per design-class tiling: copies (density) + step as a fraction of bait_len
    tiling = [
        coding     : [ density: 2, step_frac: 0.50, even: false ],
        promoter   : [ density: 3, step_frac: 0.33, even: false ],
        regulatory : [ density: 3, step_frac: 0.33, even: false ],
        cnv        : [ density: 2, step_frac: 0.50, even: true  ],
        str        : [ density: 2, step_frac: 0.33, even: false ],  // unique flanks only
        anchor     : [ density: 2, step_frac: 0.50, even: false ]
    ]

    // ---- Stage 2 : masking policy (per class) ----
    mask_low_complexity      = true
    relax_lowcplx_promoter   = true                 // promoters: keep low-complexity
    str_skip_repeat_core     = true                 // do not tile the STR repeat core

    // ---- Stage 4 : specificity ----
    specificity_aligner      = 'bowtie2'            // bowtie2 | bwa-mem2
    offtarget_min_identity   = 0.90                 // secondary hit identity threshold
    offtarget_min_lenfrac    = 0.50                 // secondary hit length fraction
    offtarget_max_hits       = 1                    // allowed off-target hits before reject
    genmap_kmer              = 120                  // = bait_len
    genmap_errors            = 2
    genmap_min_mappability   = 1.0                  // unique = 1.0

    // ---- Stage 5 : composition ----
    gc_min                   = 0.25
    gc_max                   = 0.70
    gc_max_promoter          = 0.80                 // relaxed upper bound for promoter class
    homopolymer_max          = 10
    tm_min                   = 60.0                 // °C (NN, ~hybridization-relevant)
    tm_max                   = 90.0
    dust_threshold           = 2.0                  // sdust/dustmasker entropy cutoff
    deltaG_min               = -9.0                 // optional ViennaRNA self-structure (kcal/mol)
    use_vienna               = false

    // ---- Stage 6 : gap re-tiling ----
    retile_max_passes        = 3
    coverage_target          = 0.95                 // fraction of masked target to cover

    // ---- Stage 8 : synthesis scaffolding ----
    bait_format              = 'ivt_rna'            // dna_pool | ivt_rna | ready_to_use
    t7_promoter              = 'TAATACGACTCACTATAGGG'
    pcr_handle_5             = 'ATCGCACCAGCGTGT'    // universal handles (editable)
    pcr_handle_3             = 'CACTGCGGCTCCTCA'
    synth_max_len            = 170                  // vendor synthesis length ceiling
    bait_strand              = 'plus'               // plus | minus | both

    // ---- Stage 9 : cost / manufacturability ----
    per_oligo_price          = 0.00200              // USD per oligo (editable estimate)
    pool_tiers               = [12000, 92000, 244000]   // oligo-pool size tiers
    covered_vs_raw_min       = 0.90                 // QC gate: final-covered / raw target

    // ---- Output ----
    outdir                   = 'results'
    publish_mode             = 'copy'

    // ---- Resource ceilings (overridden per profile) ----
    max_cpus                 = 8
    max_memory               = '16.GB'
    max_time                 = '24.h'
}

// ── Profiles ───────────────────────────────────────────────────────────────
profiles {
    test      { includeConfig 'conf/test.config'      }
    mac_local { includeConfig 'conf/mac_local.config' }
    hpc_slurm { includeConfig 'conf/hpc_slurm.config' }

    // Container engines (compose with the above, e.g. -profile test,docker)
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled = true
        conda.useMamba = true
    }
}

// base config (resource labels, errorStrategy, reporting) always applied
includeConfig 'conf/base.config'

// ── Nextflow run reporting ─────────────────────────────────────────────────
// Static filenames (overwrite=true); the strict config parser disallows
// arbitrary Groovy (e.g. a timestamp def) at config top level.
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }
